{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "jsx": "react-native",
    "types": ["expo-router/types"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "app",
    "lib/hazards.ts",
    "lib/supabase.ts"
  ],
  "exclude": [
    "**/__archives__/**",
    "**/__runtime_backup__/**",
    "**/__graveyard__/**",
    "**/__broken__/**",
    "**/*.bak",
    "**/*.backup",
    "node_modules"
  ]
}
