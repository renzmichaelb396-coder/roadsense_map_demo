{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "backups",
    "lib/_archive",
    "**/*.bak",
    "**/*.locked.ts",
    "**/*.locked.tsx",
    "scripts"
  ]
}