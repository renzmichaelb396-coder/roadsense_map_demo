import { supabase } from "./supabase";

export type Hazard = {
  id: string;
  type: string;
  severity: "LOW" | "MEDIUM" | "HIGH";
  status: "reported" | "resolved";
  latitude: number;
  longitude: number;
  created_at: string | null;
};

/* ------------------ helpers ------------------ */

function toNumber(v: any): number | null {
  const n = typeof v === "number" ? v : Number(v);
  return Number.isFinite(n) ? n : null;
}

function normalizeSeverity(sev: any): "LOW" | "MEDIUM" | "HIGH" {
  if (sev === 3 || String(sev).toUpperCase() === "HIGH") return "HIGH";
  if (sev === 2 || String(sev).toUpperCase() === "MEDIUM") return "MEDIUM";
  return "LOW";
}

/* ------------------ READ ------------------ */

export async function fetchHazards(): Promise<Hazard[]> {
  const { data, error } = await supabase
    .from("hazards_lgu_view")
    .select("id,type,severity,status,latitude,longitude,created_at")
    .order("created_at", { ascending: false });

  if (error) throw error;

  if (!Array.isArray(data)) return [];

  return data
    .map((r: any) => {
      const lat = toNumber(r.latitude);
      const lng = toNumber(r.longitude);
      if (lat == null || lng == null) return null;

      return {
        id: String(r.id),
        type: String(r.type ?? "pothole"),
        severity: normalizeSeverity(r.severity),
        status: (r.status === "resolved" ? "resolved" : "reported"),
        latitude: lat,
        longitude: lng,
        created_at: r.created_at ?? null,
      } as Hazard;
    })
    .filter(Boolean) as Hazard[];
}

/* ------------------ CREATE ------------------ */

export async function createHazard(input: {
  type: string;
  severity: "LOW" | "MEDIUM" | "HIGH" | number;
  latitude: number;
  longitude: number;
}): Promise<{ id: string }> {
  const severity = normalizeSeverity(input.severity);
  const location = `SRID=4326;POINT(${input.longitude} ${input.latitude})`;

  const { data, error } = await supabase
    .from("hazards")
    .insert({
      type: input.type,
      severity,
      status: "reported",
      location,
    })
    .select("id")
    .single();

  if (error) throw error;
  return { id: String(data.id) };
}

/* ------------------ UPDATE ------------------ */

export async function resolveHazard(id: string) {
  const { error } = await supabase
    .from("hazards")
    .update({ status: "resolved" })
    .eq("id", id);

  if (error) throw error;
}

export async function deleteHazard(id: string) {
  const { error } = await supabase.from("hazards").delete().eq("id", id);
  if (error) throw error;
}

/* ------------------ BACKWARD COMPAT ------------------ */

export async function loadHazards() {
  return fetchHazards();
}

export async function refreshHazardsFromCloud() {
  return fetchHazards();
}

export async function addHazard(h: any) {
  return createHazard({
    type: h?.type ?? "pothole",
    severity: h?.severity ?? "MEDIUM",
    latitude: h?.latitude,
    longitude: h?.longitude,
  });
}

export async function updateHazardStatus(id: string, status: "reported" | "resolved") {
  if (status === "resolved") return resolveHazard(id);
}
