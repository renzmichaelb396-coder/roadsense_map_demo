import React, { useEffect, useRef, useState, useMemo } from "react";
import { View, Text, Pressable, StyleSheet, Dimensions } from "react-native";
import MapView, { Marker, Region } from "react-native-maps";
import * as Location from "expo-location";

import {
  addHazard,
  deleteHazard,
  loadHazards,
  updateHazardStatus,
  Hazard,
} from "@/lib/hazards";

/* ================= CONFIG ================= */

const DEFAULT_REGION: Region = {
  latitude: 14.5995,
  longitude: 120.9842,
  latitudeDelta: 0.08,
  longitudeDelta: 0.08,
};

const SEVERITIES = [
  { key: 3, label: "HIGH", color: "#b91c1c" },
  { key: 2, label: "MEDIUM", color: "#d97706" },
  { key: 1, label: "LOW", color: "#15803d" },
] as const;

const HAZARD_TYPES = [
  { key: "pothole", label: "Pothole" },
  { key: "flood", label: "Flood" },
  { key: "crack", label: "Crack" },
  { key: "debris", label: "Debris" },
  { key: "construction", label: "Construction" },
] as const;

function uuid() {
  return "hz_" + Math.random().toString(36).slice(2) + Date.now();
}

function severityColor(sev: number) {
  if (sev === 3) return "#b91c1c";
  if (sev === 2) return "#d97706";
  return "#15803d";
}

/* ================= COMPONENT ================= */

export default function LGUMap() {
  const mapRef = useRef<MapView>(null);

  const [region, setRegion] = useState(DEFAULT_REGION);
  const [hazards, setHazards] = useState<Hazard[]>([]);
  const [selectedId, setSelectedId] = useState<string | null>(null);
  const [placementMode, setPlacementMode] = useState(false);
  const [severity, setSeverity] = useState(2);
  const [type, setType] = useState("pothole");
  const [isMutating, setIsMutating] = useState(false);

  /* ---------- LOAD ---------- */
  useEffect(() => {
    (async () => {
      try {
        const { status } = await Location.requestForegroundPermissionsAsync();
        if (status === "granted") {
          const loc = await Location.getLastKnownPositionAsync({});
          if (loc?.coords) {
            setRegion({
              latitude: loc.coords.latitude,
              longitude: loc.coords.longitude,
              latitudeDelta: 0.08,
              longitudeDelta: 0.08,
            });
          }
        }
      } catch {}
      setHazards(await loadHazards());
    })();
  }, []);

  const selected = useMemo(
    () => hazards.find(h => h.id === selectedId) ?? null,
    [hazards, selectedId]
  );

  /* ---------- ACTIONS ---------- */

  function enterPlacingMode() {
    setSelectedId(null);
    setPlacementMode(true);
  }

  async function confirmPlacement() {
    if (!mapRef.current) return;
    const { width, height } = Dimensions.get("window");

    const coord = await mapRef.current.coordinateForPoint({
      x: width / 2,
      y: height / 2,
    });

    await addHazard({
      id: uuid(),
      latitude: coord.latitude,
      longitude: coord.longitude,
      type,
      severity,
      status: "reported",
      createdAt: Date.now(),
    });

    setHazards(await loadHazards());
    setPlacementMode(false);
  }

  async function resolveSelected() {
    if (!selected || selected.status === "resolved") return;
    setIsMutating(true);
    await updateHazardStatus(selected.id, "resolved");
    setHazards(await loadHazards());
    setSelectedId(null);
    setIsMutating(false);
  }

  async function deleteSelected() {
    if (!selected) return;
    setIsMutating(true);
    await deleteHazard(selected.id);
    setHazards(await loadHazards());
    setSelectedId(null);
    setIsMutating(false);
  }

  /* ================= RENDER ================= */

  return (
    <View style={{ flex: 1 }}>
      <MapView
        ref={mapRef}
        style={{ flex: 1 }}
        initialRegion={region}
        onLongPress={enterPlacingMode}
      >
        {hazards.map(h => {
          const resolved = h.status === "resolved";
          return (
            <Marker
              key={h.id}
              coordinate={{ latitude: h.latitude, longitude: h.longitude }}
              opacity={resolved ? 0.35 : 1}
              pinColor={resolved ? "#6b7280" : severityColor(h.severity)}
              onPress={() => setSelectedId(h.id)}
            />
          );
        })}
      </MapView>

      {/* REPORT */}
      {!placementMode && (
        <Pressable style={styles.report} onPress={enterPlacingMode}>
          <Text style={styles.reportText}>REPORT ROAD HAZARD</Text>
        </Pressable>
      )}

      {/* PLACING */}
      {placementMode && (
        <>
          <View style={styles.centerPin} />
          <View style={styles.panel}>
            <Text style={styles.title}>CONFIRM LOCATION</Text>

            <View style={styles.row}>
              {SEVERITIES.map(s => (
                <Pressable
                  key={s.key}
                  onPress={() => setSeverity(s.key)}
                  style={[
                    styles.chip,
                    severity === s.key && { backgroundColor: s.color },
                  ]}
                >
                  <Text style={styles.chipText}>{s.label}</Text>
                </Pressable>
              ))}
            </View>

            <View style={styles.row}>
              {HAZARD_TYPES.map(t => (
                <Pressable
                  key={t.key}
                  onPress={() => setType(t.key)}
                  style={[
                    styles.chip,
                    type === t.key && styles.activeChip,
                  ]}
                >
                  <Text style={styles.chipText}>{t.label}</Text>
                </Pressable>
              ))}
            </View>

            <View style={styles.row}>
              <Pressable style={styles.cancel} onPress={() => setPlacementMode(false)}>
                <Text style={styles.action}>CANCEL</Text>
              </Pressable>
              <Pressable style={styles.confirm} onPress={confirmPlacement}>
                <Text style={styles.action}>CONFIRM</Text>
              </Pressable>
            </View>
          </View>
        </>
      )}

      {/* DETAIL */}
      {selected && !placementMode && (
        <View style={styles.panel}>
          <Text style={styles.title}>
            {selected.type.toUpperCase()} — {selected.status.toUpperCase()}
          </Text>

          {selected.status !== "resolved" ? (
            <View style={styles.row}>
              <Pressable style={styles.confirm} onPress={resolveSelected}>
                <Text style={styles.action}>RESOLVE</Text>
              </Pressable>
              <Pressable style={styles.delete} onPress={deleteSelected}>
                <Text style={styles.action}>DELETE</Text>
              </Pressable>
            </View>
          ) : (
            <Text style={styles.resolvedNote}>
              This hazard is resolved and kept for historical reference.
            </Text>
          )}
        </View>
      )}
    </View>
  );
}

/* ================= STYLES ================= */

const styles = StyleSheet.create({
  report: {
    position: "absolute",
    left: 16,
    right: 16,
    bottom: 24,
    backgroundColor: "#020617",
    padding: 16,
    borderRadius: 14,
    alignItems: "center",
  },
  reportText: { color: "white", fontWeight: "900", letterSpacing: 0.5 },

  centerPin: {
    position: "absolute",
    left: "50%",
    top: "50%",
    marginLeft: -9,
    marginTop: -9,
    width: 18,
    height: 18,
    borderRadius: 9,
    backgroundColor: "#b91c1c",
    borderWidth: 3,
    borderColor: "white",
  },

  panel: {
    position: "absolute",
    left: 12,
    right: 12,
    bottom: 20,
    backgroundColor: "#020617",
    borderRadius: 16,
    padding: 14,
  },

  title: {
    color: "#e5e7eb",
    fontWeight: "900",
    marginBottom: 10,
  },

  row: { flexDirection: "row", gap: 8, marginBottom: 10 },

  chip: {
    flex: 1,
    paddingVertical: 8,
    borderRadius: 10,
    backgroundColor: "#334155",
    alignItems: "center",
  },
  activeChip: { backgroundColor: "#475569" },
  chipText: { color: "white", fontWeight: "700" },

  cancel: { flex: 1, backgroundColor: "#334155", padding: 12, borderRadius: 10 },
  confirm: { flex: 1, backgroundColor: "#15803d", padding: 12, borderRadius: 10 },
  delete: { flex: 1, backgroundColor: "#991b1b", padding: 12, borderRadius: 10 },

  action: { color: "white", fontWeight: "900", textAlign: "center" },

  resolvedNote: {
    color: "#9ca3af",
    fontStyle: "italic",
  },
});
