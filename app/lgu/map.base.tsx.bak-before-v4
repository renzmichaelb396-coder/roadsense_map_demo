import React, { useEffect, useMemo, useRef, useState } from "react";
import { View, Text, Pressable, Dimensions } from "react-native";
import MapView, { Marker, MapPressEvent, Region } from "react-native-maps";
import * as Location from "expo-location";
import { addHazard, deleteHazard, loadHazards, updateHazardStatus, Hazard } from "@/lib/hazards";

/* ================= LGU OPS – UX V3 (GLANCEABLE) ================= */

const DEFAULT_REGION: Region = {
  latitude: 14.5995,
  longitude: 120.9842,
  latitudeDelta: 0.08,
  longitudeDelta: 0.08,
};

const SEVERITIES = [
  { key: 3, label: "HIGH", color: "#ef4444" },
  { key: 2, label: "MEDIUM", color: "#f59e0b" },
  { key: 1, label: "LOW", color: "#10b981" },
] as const;

type Severity = 1 | 2 | 3;

const HAZARD_TYPES = [
  { key: "pothole", label: "Pothole" },
  { key: "flood", label: "Flood" },
  { key: "crack", label: "Crack" },
  { key: "debris", label: "Debris" },
  { key: "construction", label: "Construction" },
] as const;

type HazardType = (typeof HAZARD_TYPES)[number]["key"];

function severityMeta(sev: number) {
  return SEVERITIES.find(s => s.key === sev) ?? SEVERITIES[2];
}

function safeStatus(h: any): "reported" | "resolved" {
  return h?.status === "resolved" ? "resolved" : "reported";
}

function shortTypeLabel(t: string) {
  return HAZARD_TYPES.find(x => x.key === t)?.label ?? "Hazard";
}

function makeId() {
  return `hz_${Date.now()}_${Math.random().toString(16).slice(2)}`;
}

/* ================= COMPONENT ================= */

export default function LGUMap() {
  const mapRef = useRef<MapView | null>(null);

  const [region, setRegion] = useState(DEFAULT_REGION);
  const [userCoord, setUserCoord] = useState<{ latitude: number; longitude: number } | null>(null);

  const [hazards, setHazards] = useState<Hazard[]>([]);
  const [selectedId, setSelectedId] = useState<string | null>(null);
  const [isMutating, setIsMutating] = useState(false);

  const [placing, setPlacing] = useState(false);
  const [severity, setSeverity] = useState<Severity>(2);
  const [type, setType] = useState<HazardType>("pothole");

  const [showResolved, setShowResolved] = useState(true);

  async function reload() {
    const h = await loadHazards();
    setHazards(Array.isArray(h) ? h : []);
  }

  useEffect(() => {
    (async () => {
      const { status } = await Location.requestForegroundPermissionsAsync();
      if (status === "granted") {
        const loc = await Location.getLastKnownPositionAsync({});
        if (loc?.coords) {
          const r = {
            latitude: loc.coords.latitude,
            longitude: loc.coords.longitude,
            latitudeDelta: 0.06,
            longitudeDelta: 0.06,
          };
          setRegion(r);
          setUserCoord({ latitude: r.latitude, longitude: r.longitude });
        }
      }
      await reload();
    })();
  }, []);

  const selected = useMemo(
    () => hazards.find(h => String((h as any).id) === selectedId) ?? null,
    [hazards, selectedId]
  );

  function enterPlacing() {
    setSelectedId(null);
    setPlacing(true);
  }

  async function confirmPlacement() {
    if (!mapRef.current || isMutating) return;
    setIsMutating(true);

    try {
      const { width, height } = Dimensions.get("window");
      const coord = await mapRef.current.coordinateForPoint({ x: width / 2, y: height / 2 });

      await addHazard({
        id: makeId(),
        latitude: coord.latitude,
        longitude: coord.longitude,
        type,
        severity,
        status: "reported",
        createdAt: Date.now(),
      } as any);

      await reload();
    } finally {
      setPlacing(false);
      setIsMutating(false);
    }
  }

  async function resolve() {
    if (!selected) return;
    setIsMutating(true);
    await updateHazardStatus((selected as any).id, "resolved" as any);
    await reload();
    setIsMutating(false);
  }

  async function remove() {
    if (!selected) return;
    setSelectedId(null);
    setIsMutating(true);
    await deleteHazard((selected as any).id);
    await reload();
    setIsMutating(false);
  }

  /* ================= RENDER ================= */

  return (
    <View style={{ flex: 1 }}>
      <MapView
        ref={r => (mapRef.current = r)}
        style={{ flex: 1 }}
        initialRegion={region}
        onLongPress={() => !isMutating && enterPlacing()}
        showsUserLocation
        showsMyLocationButton={false}
      >
        {hazards
          .filter(h => showResolved || safeStatus(h) !== "resolved")
          .map(h => {
            const st = safeStatus(h);
            const meta = severityMeta(h.severity);
            return (
              <Marker
                key={`${h.id}-${st}`}
                coordinate={{ latitude: h.latitude, longitude: h.longitude }}
                pinColor={st === "resolved" ? "#64748b" : meta.color}
                opacity={st === "resolved" ? 0.25 : 1}
                onPress={() => setSelectedId(String((h as any).id))}
              />
            );
          })}
      </MapView>

      {/* TOP BAR */}
      <View style={{
        position: "absolute",
        top: 12,
        left: 12,
        right: 12,
        padding: 12,
        borderRadius: 16,
        backgroundColor: "rgba(2,6,23,0.75)",
        flexDirection: "row",
        justifyContent: "space-between",
      }}>
        <Text style={{ color: "white", fontWeight: "900" }}>LGU HAZARD OPS</Text>
        <Pressable onPress={() => setShowResolved(v => !v)}>
          <Text style={{ color: "white", fontWeight: "800" }}>
            Resolved: {showResolved ? "ON" : "OFF"}
          </Text>
        </Pressable>
      </View>

      {/* SELECTION CARD (UX V3) */}
      {selected && (
        <View style={{
          position: "absolute",
          left: 12,
          right: 12,
          bottom: 88,
          borderRadius: 22,
          overflow: "hidden",
          backgroundColor: "rgba(2,6,23,0.95)",
        }}>
          <View style={{
            backgroundColor: safeStatus(selected) === "resolved" ? "#475569" : severityMeta(selected.severity).color,
            padding: 12,
          }}>
            <Text style={{ color: "white", fontWeight: "900", fontSize: 16 }}>
              {shortTypeLabel((selected as any).type)}
            </Text>
            <Text style={{ color: "white", fontWeight: "800", fontSize: 12 }}>
              {safeStatus(selected) === "resolved" ? "HISTORICAL" : "ACTIVE"} • Severity {severityMeta(selected.severity).label}
            </Text>
          </View>

          <View style={{ padding: 14 }}>
            <Text style={{ color: "rgba(226,232,240,0.9)", marginBottom: 10 }}>
              {safeStatus(selected) === "resolved"
                ? "Kept for accountability and audit trail."
                : "Validate on-ground. Resolve when confirmed; delete only if invalid or duplicate."}
            </Text>

            <View style={{ flexDirection: "row", gap: 10 }}>
              <Pressable onPress={() => setSelectedId(null)} style={{ flex: 1, padding: 12, borderRadius: 14, backgroundColor: "#334155" }}>
                <Text style={{ color: "white", fontWeight: "900", textAlign: "center" }}>CLOSE</Text>
              </Pressable>

              {safeStatus(selected) !== "resolved" && (
                <Pressable onPress={resolve} style={{ flex: 1, padding: 12, borderRadius: 14, backgroundColor: "#16a34a" }}>
                  <Text style={{ color: "white", fontWeight: "900", textAlign: "center" }}>RESOLVE</Text>
                </Pressable>
              )}
            </View>

            <Pressable onPress={remove} style={{ marginTop: 10, padding: 12, borderRadius: 14, backgroundColor: "#991b1b" }}>
              <Text style={{ color: "white", fontWeight: "900", textAlign: "center" }}>
                DELETE (INVALID / DUPLICATE ONLY)
              </Text>
            </Pressable>
          </View>
        </View>
      )}
    </View>
  );
}
