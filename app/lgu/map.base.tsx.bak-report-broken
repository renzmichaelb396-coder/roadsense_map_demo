import React, { useEffect, useMemo, useRef, useState } from "react";
import { View, Text, Pressable } from "react-native";
import MapView, { Marker, Region } from "react-native-maps";
import * as Location from "expo-location";

import {
  Hazard,
  HazardType,
  fetchHazards,
  createHazard,
  resolveHazard,
  deleteHazard,
} from "@/lib/hazards";

const DEFAULT_REGION: Region = {
  latitude: 14.5995,
  longitude: 120.9842,
  latitudeDelta: 0.6,
  longitudeDelta: 0.6,
};

export default function LGUMap() {
  const mapRef = useRef<MapView | null>(null);

  const [region, setRegion] = useState(DEFAULT_REGION);
  const [userCoord, setUserCoord] = useState<Location.LocationObjectCoords | null>(null);

  const [hazards, setHazards] = useState<any[]>([]);
  const [selectedId, setSelectedId] = useState<string | null>(null);

  const [showResolved, setShowResolved] = useState(true);
  const [placing, setPlacing] = useState(false);
  const [isMutating, setIsMutating] = useState(false);

  const [severity, setSeverity] = useState<1 | 2 | 3>(2);
  const [type, setType] = useState<HazardType>("pothole");

  /* ================= DATA ================= */

  async function reload() {
  const data = await fetchHazards();
  setHazards(Array.isArray(data) ? data : []);
}

  useEffect(() => {
    reload();
  }, []);

  useEffect(() => {
    (async () => {
      const { status } = await Location.requestForegroundPermissionsAsync();
      if (status !== "granted") return;
      const loc = await Location.getCurrentPositionAsync({});
      setUserCoord(loc.coords);
    })();
  }, []);

  const selected = useMemo(
    () => hazards.find(h => h.id === selectedId) ?? null,
    [selectedId, hazards]
  );

  const visibleHazards = useMemo(() => {
    return hazards.filter(h => showResolved || h.status !== "resolved");
  }, [hazards, showResolved]);

  /* ================= ACTIONS ================= */

  function enterPlacing() {
    if (isMutating) return;
    setSelectedId(null);
    setPlacing(true);
  }

  function cancelPlacing() {
    setPlacing(false);
  }

  async function confirmPlacing() {
    if (!mapRef.current) return;
    setIsMutating(true);

    const cam = await mapRef.current.getCamera();
    await createHazard({
      latitude: cam.center.latitude,
      longitude: cam.center.longitude,
      severity,
      type,
    });

    setPlacing(false);
    await reload();
    setIsMutating(false);
  }

  async function resolveSelected() {
    if (!selected) return;
    setIsMutating(true);
    await resolveHazard(selected.id);
    await reload();
    setIsMutating(false);
  }

  async function deleteSelected() {
    if (!selected) return;
    setIsMutating(true);
    await deleteHazard(selected.id);
    await reload();
    setIsMutating(false);
  }

  /* ================= RENDER ================= */

  return (
    <View style={{ flex: 1 }}>
      <MapView
        ref={r => (mapRef.current = r)}
        style={{ flex: 1 }}
        initialRegion={region}
        onLongPress={enterPlacing}
        showsUserLocation
        showsMyLocationButton={false}
      >
        {visibleHazards.map(h => {
          const isResolved = h.status === "resolved";
          const markerKey = `${h.id}-${h.status}`;

          const color =
            h.severity === 3 ? "#dc2626" :
            h.severity === 2 ? "#f59e0b" :
            "#22c55e";

          return (
            <Marker
              key={markerKey}
              coordinate={{ latitude: h.latitude, longitude: h.longitude }}
              tracksViewChanges={false}
              onPress={() => setSelectedId(h.id)}
            >
              <View
                style={{
                  width: isResolved ? 14 : 26,
                  height: isResolved ? 14 : 26,
                  borderRadius: 13,
                  backgroundColor: isResolved ? "transparent" : color,
                  borderWidth: isResolved ? 2 : 0,
                  borderColor: "#64748b",
                  opacity: isResolved ? 0.35 : 1,
                }}
              />
            </Marker>
          );
        })}
      </MapView>

      {/* TOP BAR */}
      <View style={{
        position: "absolute",
        top: 12,
        left: 12,
        right: 12,
        padding: 12,
        borderRadius: 16,
        backgroundColor: "rgba(2,6,23,0.85)",
        flexDirection: "row",
        justifyContent: "space-between",
      }}>
        <Text style={{ color: "white", fontWeight: "900" }}>LGU HAZARD OPS</Text>
        <Pressable onPress={() => setShowResolved(v => !v)}>
          <Text style={{ color: "white", fontWeight: "800" }}>
            Resolved: {showResolved ? "ON" : "OFF"}
          </Text>
        </Pressable>
      </View>

      {/* REPORT BUTTON */}
      {!placing && !selected && (
        <Pressable
          onPress={enterPlacing}
          style={{
            position: "absolute",
            left: 16,
            right: 16,
            bottom: 96,
            backgroundColor: "#2563eb",
            paddingVertical: 16,
            borderRadius: 22,
            alignItems: "center",
          }}
        >
          <Text style={{ color: "white", fontWeight: "900", fontSize: 16 }}>
            + REPORT HAZARD
          </Text>
        </Pressable>
      )}

      {/* PLACING PANEL */}
      {placing && (
        <View style={{
          position: "absolute",
          left: 16,
          right: 16,
          bottom: 96,
          backgroundColor: "rgba(2,6,23,0.95)",
          padding: 16,
          borderRadius: 22,
        }}>
          <Text style={{ color: "white", fontWeight: "900", marginBottom: 10 }}>
            Place hazard at center
          </Text>

          <View style={{ flexDirection: "row", gap: 10 }}>
            <Pressable
              onPress={cancelPlacing}
              style={{ flex: 1, padding: 14, backgroundColor: "#475569", borderRadius: 14 }}
            >
              <Text style={{ color: "white", fontWeight: "900", textAlign: "center" }}>
                CANCEL
              </Text>
            </Pressable>

            <Pressable
              onPress={confirmPlacing}
              style={{ flex: 1, padding: 14, backgroundColor: "#16a34a", borderRadius: 14 }}
            >
              <Text style={{ color: "white", fontWeight: "900", textAlign: "center" }}>
                CONFIRM
              </Text>
            </Pressable>
          </View>
        </View>
      )}

      {/* SELECTION CARD */}
      {selected && (
        <View style={{
          position: "absolute",
          left: 16,
          right: 16,
          bottom: 96,
          backgroundColor: selected.status === "resolved" ? "#334155" : "#dc2626",
          padding: 16,
          borderRadius: 24,
        }}>
          <Text style={{ color: "white", fontWeight: "900", fontSize: 16 }}>
            {selected.type.toUpperCase()} • {selected.status.toUpperCase()} • SEVERITY {selected.severity}
          </Text>

          <View style={{ flexDirection: "row", gap: 10, marginTop: 12 }}>
            <Pressable
              onPress={() => setSelectedId(null)}
              style={{ flex: 1, padding: 12, backgroundColor: "#475569", borderRadius: 14 }}
            >
              <Text style={{ color: "white", fontWeight: "900", textAlign: "center" }}>
                CLOSE
              </Text>
            </Pressable>

            {selected.status !== "resolved" && (
              <Pressable
                onPress={resolveSelected}
                style={{ flex: 1, padding: 12, backgroundColor: "#16a34a", borderRadius: 14 }}
              >
                <Text style={{ color: "white", fontWeight: "900", textAlign: "center" }}>
                  RESOLVE
                </Text>
              </Pressable>
            )}
          </View>

          <Pressable
            onPress={deleteSelected}
            style={{ marginTop: 10, padding: 12, backgroundColor: "#7f1d1d", borderRadius: 14 }}
          >
            <Text style={{ color: "white", fontWeight: "900", textAlign: "center" }}>
              DELETE (INVALID / DUPLICATE ONLY)
            </Text>
          </Pressable>
        </View>
      )}
    </View>
  );
}
