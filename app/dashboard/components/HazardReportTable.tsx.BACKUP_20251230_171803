type Severity = "HIGH" | "MEDIUM" | "LOW";

export default function HazardReportTable<T extends {
  id: string;
  type: string;
  severity: Severity;
  status: "reported" | "resolved";
}>({
  hazards,
  getActionLabel,
}: {
  hazards: T[];
  getActionLabel?: (h: T) =>
    | "Needs Immediate Action"
    | "Schedule Repair"
    | "Monitor"
    | "Resolved";
}) {
  function displayStatus(status: "reported" | "resolved") {
    return status === "reported" ? "ACTIVE" : "RESOLVED";
  }

  function severityStyle(sev: Severity) {
    if (sev === "HIGH")
      return {
        borderLeft: "8px solid #b91c1c",
        background: "#7f1d1d",
        color: "#fff",
        fontWeight: 800,
      };
    if (sev === "MEDIUM")
      return {
        borderLeft: "8px solid #d97706",
        background: "#92400e",
        color: "#fff",
        fontWeight: 700,
      };
    return {
      borderLeft: "8px solid #15803d",
      background: "#064e3b",
      color: "#ecfdf5",
      fontWeight: 600,
    };
  }

  return (
    <table
      style={{
        width: "100%",
        borderCollapse: "collapse",
        fontSize: 14,
      }}
    >
      <thead>
        <tr style={{ background: "#020617", color: "#e5e7eb" }}>
          <th align="left" style={{ padding: 10 }}>Type</th>
          <th align="left" style={{ padding: 10 }}>Severity</th>
          <th align="left" style={{ padding: 10 }}>Status</th>
          {getActionLabel && (
            <th align="left" style={{ padding: 10 }}>Action Required</th>
          )}
        </tr>
      </thead>
      <tbody>
        {hazards.map((h) => (
          <tr
            key={h.id}
            style={{
              ...severityStyle(h.severity),
              borderBottom: "1px solid rgba(255,255,255,0.15)",
            }}
          >
            <td style={{ padding: 10 }}>{h.type}</td>
            <td style={{ padding: 10 }}>{h.severity}</td>
            <td style={{ padding: 10 }}>{displayStatus(h.status)}</td>
            {getActionLabel && (
              <td style={{ padding: 10 }}>{getActionLabel(h)}</td>
            )}
          </tr>
        ))}
      </tbody>
    </table>
  );
}
